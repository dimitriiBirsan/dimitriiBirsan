---
import DarkPatternLabel from "./DarkPatternLabel.astro";

const tickerItems = [
    { user: "User7281", action: "just upgraded to Enterprise" },
    { user: "User3945", action: "purchased 10,000 Credits" },
    { user: "User1562", action: "unlocked Premium Features" },
    { user: "User9103", action: "just upgraded to Enterprise" },
    { user: "User6428", action: "purchased 10,000 Credits" },
    { user: "User2847", action: "unlocked Premium Features" },
];
---

<!-- Social Proof -->
<section aria-label="Dark pattern demo: Social Proof Fabricator">
    <div class="glass-card">
        <h2 class="section-title">Social Proof Fabricator</h2>
        <DarkPatternLabel
            categories={["Social Engineering", "Sneaking"]}
            tooltip="Social Engineering: Fabricated testimonials to create FOMO"
        />
        <details class="dp-fix">
            <summary>What good UX looks like</summary>
            <div class="dp-fix-content">
                <ul>
                    <li>Only show real activity — fabricated social proof destroys trust permanently when users discover it.</li>
                    <li>If using live notifications, throttle and verify them; showing one per minute of real activity is more credible than a firehose of fake ones.</li>
                    <li>Silence is better than fiction — no ticker beats a lying ticker every time.</li>
                </ul>
            </div>
        </details>
        <p class="section-subtitle">
            Everyone's upgrading! (Except they're not.)
        </p>

        <div class="ticker-container">
            <div class="ticker" id="ticker">
                {
                    tickerItems.map((item) => (
                        <div class="ticker-item">
                            👤 <span class="highlight">{item.user}</span>{" "}
                            {item.action}
                        </div>
                    ))
                }
                <!-- Duplicate for seamless scroll -->
                {
                    tickerItems.map((item) => (
                        <div class="ticker-item">
                            👤 <span class="highlight">{item.user}</span>{" "}
                            {item.action}
                        </div>
                    ))
                }
            </div>
        </div>
        <p
            style="color: var(--text-muted); text-align: center; margin-top: 1.5rem; font-style: italic;"
        >
            (These are 100% real users doing real things. Trust us. We're a SaaS
            company.)
        </p>
    </div>
</section>
