---
import DarkPatternLabel from "./DarkPatternLabel.astro";
---

<!-- Gacha System -->
<section>
    <div class="glass-card">
        <h2 class="section-title">The Analytics Gacha</h2>
        <DarkPatternLabel
            categories={["Sneaking", "Interface Interference"]}
            tooltip="Sneaking + Interface Interference: Hidden costs via confusing gacha mechanics"
        />
        <p class="section-subtitle">
            Spin to unlock basic features! (Yes, basic features.)
        </p>

        <div class="gacha-container">
            <!-- Featured Item Banner -->
            <div class="gacha-featured-banner">
                New Featured Item: <span class="featured-highlight"
                    >PDF Export (SR)!</span
                >
            </div>

            <!-- Gacha Cards Grid -->
            <div class="gacha-cards-grid">
                <!-- Dark Mode - Rare (Unlocked) -->
                <div class="gacha-card unlocked rarity-r" data-rarity="R">
                    <div class="card-rarity-badge">R</div>
                    <div class="card-icon">
                        <img
                            src="/assets/gacha/chibi_dark_mode_r.png"
                            alt="Dark Mode"
                            style="width: 80px; height: 80px; object-fit: contain; filter: drop-shadow(0 0 8px rgba(147,51,234,0.6));"
                        />
                    </div>
                    <div class="card-label">Dark Mode (R)</div>
                </div>

                <!-- Date Picker - Normal (Unlocked) -->
                <div class="gacha-card unlocked rarity-n" data-rarity="N">
                    <div class="card-rarity-badge">N</div>
                    <div class="card-icon">
                        <img
                            src="/assets/gacha/chibi_date_picker_n.png"
                            alt="Date Picker"
                            style="width: 80px; height: 80px; object-fit: contain; filter: drop-shadow(0 0 8px rgba(100,149,237,0.4));"
                        />
                    </div>
                    <div class="card-label">Date Picker (N)</div>
                </div>

                <!-- Export PDF - Super Rare (Featured, Locked) -->
                <div
                    class="gacha-card locked featured rarity-sr"
                    data-rarity="SR"
                >
                    <div class="card-rarity-badge">SR</div>
                    <div class="card-icon">
                        <img
                            src="/assets/gacha/chibi_export_pdf_sr.png"
                            alt="Export PDF"
                            style="width: 100px; height: 100px; object-fit: contain; filter: drop-shadow(0 0 15px rgba(255,215,0,0.8)); margin: -10px 0;"
                        />
                    </div>
                    <div class="card-label">Export PDF (SR)</div>
                    <div class="featured-tag">★ FEATURED ★</div>
                </div>

                <!-- CSV Export - Rare (Locked) -->
                <div class="gacha-card locked rarity-r" data-rarity="R">
                    <div class="card-rarity-badge">R</div>
                    <div class="card-icon">
                        <img
                            src="/assets/gacha/chibi_csv_export_r.png"
                            alt="CSV Export"
                            style="width: 80px; height: 80px; object-fit: contain; filter: drop-shadow(0 0 8px rgba(147,51,234,0.6));"
                        />
                    </div>
                    <div class="card-label">CSV Export (R)</div>
                </div>

                <!-- Custom Report - Super Rare (Locked) -->
                <div class="gacha-card locked rarity-sr" data-rarity="SR">
                    <div class="card-rarity-badge">SR</div>
                    <div class="card-icon">
                        <img
                            src="/assets/gacha/chibi_custom_report_sr.png"
                            alt="Custom Report"
                            style="width: 100px; height: 100px; object-fit: contain; filter: drop-shadow(0 0 15px rgba(255,215,0,0.8)); margin: -10px 0;"
                        />
                    </div>
                    <div class="card-label">Custom Report (SR)</div>
                </div>

                <!-- Bulk Edit - Rare (Locked) -->
                <div class="gacha-card locked rarity-r" data-rarity="R">
                    <div class="card-rarity-badge">R</div>
                    <div class="card-icon">
                        <img
                            src="/assets/gacha/chibi_bulk_edit_r.png"
                            alt="Bulk Edit"
                            style="width: 80px; height: 80px; object-fit: contain; filter: drop-shadow(0 0 8px rgba(147,51,234,0.6));"
                        />
                    </div>
                    <div class="card-label">Bulk Edit (R)</div>
                </div>
            </div>

            <!-- Gacha Wheel -->
            <div class="gacha-wheel-wrapper">
                <div class="gacha-pointer"></div>
                <div class="gacha-wheel" id="gachaWheel">
                    <div class="wheel-segment">N</div>
                    <div class="wheel-segment">N</div>
                    <div class="wheel-segment">N</div>
                    <div class="wheel-segment">N</div>
                    <div class="wheel-segment">N</div>
                    <div class="wheel-segment">R</div>
                    <div class="wheel-segment">N</div>
                    <div class="wheel-segment">N</div>
                    <div class="wheel-segment">N</div>
                    <div class="wheel-segment">SR</div>
                </div>
            </div>

            <!-- Spin Buttons -->
            <div class="gacha-spin-buttons">
                <button class="spin-button spin-1x" id="gachaSpin1x">
                    <div class="spin-label">1x Spin (500 Insight Shards)</div>
                </button>
                <button class="spin-button spin-10x" id="gachaSpin10x">
                    <div class="spin-label">
                        10x Spin (5,000 Shards - Guaranteed R or Higher!)
                    </div>
                </button>
            </div>

            <!-- Balance Display -->
            <div class="gacha-balance">
                <div class="balance-item">
                    <span class="balance-label">Your balance:</span>
                    <span class="balance-value" id="gachaShardBalance"
                        >2,347 Insight Shards</span
                    >
                </div>
                <div class="balance-item premium">
                    <span class="balance-label">Balance:</span>
                    <span class="balance-value" id="gachaGemBalance"
                        >50 Gems (Premium Currency)</span
                    >
                    <a href="#" class="buy-more-link">[Buy More]</a>
                </div>
            </div>

            <!-- Drop Rates -->
            <div class="gacha-footer">
                <p class="drop-rates-text">
                    Note: SR rate: 0.5%. R rate: 5%. N rate 94.5%. Landing on
                    "Export PDF" has a 0.003% probability. Good luck!
                </p>
                <button class="drop-rates-btn" id="dropRatesBtn">
                    Drop Rates ▸
                </button>
            </div>

            <!-- Drop Rates Modal and Results Overlay logic moved outside the container -->
        </div>
    </div>
</section>

<!-- Modals moved outside to avoid containing block issues from backdrop-filter -->
<!-- Drop Rates Modal (Hidden by default) -->
<div class="drop-rates-modal" id="dropRatesModal" style="display: none;">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h3>Drop Rates</h3>
            <button class="modal-close" id="closeDropRates">✕</button>
        </div>
        <div class="modal-body">
            <div class="rate-tier">
                <div class="tier-name rarity-sr">Super Rare (SR)</div>
                <div class="tier-rate">0.5%</div>
                <div class="tier-items">
                    <div class="tier-item">
                        <span>📄 Export PDF</span>
                        <span class="item-rate">0.003%</span>
                    </div>
                    <div class="tier-item">
                        <span>📊 Custom Report</span>
                        <span class="item-rate">0.247%</span>
                    </div>
                    <div class="tier-item">
                        <span>📈 Advanced Analytics</span>
                        <span class="item-rate">0.25%</span>
                    </div>
                </div>
            </div>
            <div class="rate-tier">
                <div class="tier-name rarity-r">Rare (R)</div>
                <div class="tier-rate">5.0%</div>
                <div class="tier-items">
                    <div class="tier-item">
                        <span>🌙 Dark Mode</span>
                        <span class="item-rate">1.2%</span>
                    </div>
                    <div class="tier-item">
                        <span>📊 CSV Export</span>
                        <span class="item-rate">1.3%</span>
                    </div>
                    <div class="tier-item">
                        <span>✏️ Bulk Edit</span>
                        <span class="item-rate">1.2%</span>
                    </div>
                    <div class="tier-item">
                        <span>🎨 Custom Themes</span>
                        <span class="item-rate">1.3%</span>
                    </div>
                </div>
            </div>
            <div class="rate-tier">
                <div class="tier-name rarity-n">Normal (N)</div>
                <div class="tier-rate">94.5%</div>
                <div class="tier-items">
                    <div class="tier-item">
                        <span>📅 Date Picker</span>
                        <span class="item-rate">31.5%</span>
                    </div>
                    <div class="tier-item">
                        <span>🔔 Email Notifications</span>
                        <span class="item-rate">31.5%</span>
                    </div>
                    <div class="tier-item">
                        <span>📝 Basic Reports</span>
                        <span class="item-rate">31.5%</span>
                    </div>
                </div>
            </div>
            <p class="modal-disclaimer">
                * Rates based on the "player-friendly" gacha model.
                (Translation: We make it seem fair while ensuring you never get
                what you want.)
            </p>
        </div>
    </div>
</div>

<!-- Results Overlay -->
<div class="gacha-results-overlay" id="gachaResultsOverlay">
    <div class="result-card" id="gachaResultCard">
        <div class="result-title" id="gachaResultTitle">You got...</div>
        <div class="result-rarity" id="gachaResultRarity">R</div>
        <div class="result-item" id="gachaResultItem">Dark Mode</div>
        <button class="claim-btn" id="claimResultBtn">Claim</button>
        <div
            id="nearMissMsg"
            style="display: none; margin-top: 1.5rem; color: var(--danger); font-size: 0.9rem; font-weight: bold;"
        >
            So close! You were a hair away from the SR... Time to spin again! 😈
        </div>
    </div>
</div>

<script>
    // Gacha System
    let gachaBalance = 2347;
    const gachaSpin1x = document.getElementById("gachaSpin1x");
    const gachaSpin10x = document.getElementById("gachaSpin10x");
    const dropRatesBtn = document.getElementById("dropRatesBtn");
    const dropRatesModal = document.getElementById("dropRatesModal");
    const closeDropRates = document.getElementById("closeDropRates");
    const shardBalanceEl = document.getElementById("gachaShardBalance");

    // Wheel and Overlay
    const wheel = document.getElementById("gachaWheel") as HTMLDivElement;
    let currentRotation = 0;
    let isSpinning = false;

    const resultsOverlay = document.getElementById(
        "gachaResultsOverlay",
    ) as HTMLDivElement;
    const resultCard = document.getElementById(
        "gachaResultCard",
    ) as HTMLDivElement;
    const resultRarity = document.getElementById(
        "gachaResultRarity",
    ) as HTMLDivElement;
    const resultItem = document.getElementById(
        "gachaResultItem",
    ) as HTMLDivElement;
    const resultTitle = document.getElementById(
        "gachaResultTitle",
    ) as HTMLDivElement;
    const claimBtn = document.getElementById(
        "claimResultBtn",
    ) as HTMLButtonElement;
    const nearMissMsg = document.getElementById(
        "nearMissMsg",
    ) as HTMLDivElement;

    // Modal controls
    dropRatesBtn?.addEventListener("click", () => {
        if (dropRatesModal) {
            dropRatesModal.style.display = "flex";
        }
    });

    closeDropRates?.addEventListener("click", () => {
        if (dropRatesModal) {
            dropRatesModal.style.display = "none";
        }
    });

    // Click backdrop to close
    dropRatesModal
        ?.querySelector(".modal-backdrop")
        ?.addEventListener("click", () => {
            if (dropRatesModal) {
                dropRatesModal.style.display = "none";
            }
        });

    claimBtn?.addEventListener("click", () => {
        resultsOverlay.classList.remove("active");
    });

    function showResults(
        results: {
            rarity: string;
            item: string;
            segment: number;
            isNearMiss?: boolean;
        }[],
        isMulti: boolean,
        isNearMiss: boolean,
    ) {
        // Display the most significant or last result
        const displayResult = isMulti
            ? results[results.length - 1]
            : results[0];

        resultCard.className = "result-card " + displayResult.rarity;
        resultRarity.textContent = displayResult.rarity;
        resultItem.textContent = displayResult.item;

        if (isMulti) {
            resultTitle.textContent = "10x Results include...";
        } else {
            resultTitle.textContent = "You got...";
        }

        if (isNearMiss) {
            nearMissMsg.style.display = "block";
        } else {
            nearMissMsg.style.display = "none";
        }

        resultsOverlay.classList.add("active");
        isSpinning = false;
    }

    // Gacha spin function
    function performGachaSpin(isMulti = false) {
        if (isSpinning) return;

        const cost = isMulti ? 5000 : 500;
        const spins = isMulti ? 10 : 1;

        if (gachaBalance < cost) {
            alert("Insufficient Insight Shards! (Time to open your wallet 💸)");
            return;
        }

        isSpinning = true;
        gachaBalance -= cost;
        if (shardBalanceEl) {
            shardBalanceEl.textContent = `${gachaBalance.toLocaleString()} Insight Shards`;
        }

        // Simulate gacha results (always near-miss for SR items)
        const results: {
            rarity: string;
            item: string;
            segment: number;
            isNearMiss?: boolean;
        }[] = [];
        let displayResult = null;
        let targetSegment = 1;

        for (let i = 0; i < spins; i++) {
            // Rigged rates
            const roll = Math.random();
            let res: {
                rarity: string;
                item: string;
                segment: number;
                isNearMiss?: boolean;
            } = { rarity: "N", item: "Date Picker", segment: 1 };

            if (roll < 0.005) {
                res = { rarity: "SR", item: "Custom Report", segment: 10 }; // Not the featured!
            } else if (roll < 0.055) {
                const rares = ["Dark Mode", "CSV Export", "Bulk Edit"];
                res = {
                    rarity: "R",
                    item: rares[Math.floor(Math.random() * rares.length)],
                    segment: 6,
                };
            } else {
                const normals = ["Date Picker", "Email Notifications"];
                res = {
                    rarity: "N",
                    item: normals[Math.floor(Math.random() * normals.length)],
                    segment: 1,
                };
                // 70% chance of a near miss for N items to cause maximum frustration
                if (Math.random() < 0.7) {
                    res.segment = 9; // Near SR
                    res.isNearMiss = true;
                } else {
                    res.segment = [1, 2, 3, 4, 5, 7, 8][
                        Math.floor(Math.random() * 7)
                    ];
                }
            }
            results.push(res);

            // In multi, we still just show the wheel spin for the last item for dramatic effect
            if (i === spins - 1) {
                displayResult = res;
                targetSegment = res.segment;
            }
        }

        // Calculate angle
        // Center of segment = segment * 36 - 18
        let targetAngle = targetSegment * 36 - 18;

        if (displayResult?.isNearMiss) {
            // Segment 10 (SR) starts at 324. Segment 9 is 288 to 324.
            // We want to stop exactly before 324, so 322.
            targetAngle = 322;
        }

        // Rotation needed to place targetAngle at the top (0deg)
        const rotationValueForTarget = 360 - targetAngle;

        // Add 5 full rotations for dramatic effect
        const extraSpins = 5 * 360;

        const remainder = currentRotation % 360;
        let nextRotation = currentRotation - remainder + rotationValueForTarget;

        if (nextRotation <= currentRotation) {
            nextRotation += 360;
        }
        nextRotation += extraSpins;

        wheel.style.transform = `rotate(${nextRotation}deg)`;
        currentRotation = nextRotation;

        setTimeout(() => {
            showResults(results, isMulti, !!displayResult?.isNearMiss);
        }, 5200); // 5s transition + small buffer
    }

    gachaSpin1x?.addEventListener("click", () => performGachaSpin(false));
    gachaSpin10x?.addEventListener("click", () => performGachaSpin(true));
</script>
