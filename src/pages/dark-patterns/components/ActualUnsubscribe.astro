    document
        .getElementById("actualUnsubscribe")
        ?.addEventListener("click", (e) => {
            e.preventDefault();
            alert(
                "Congratulations! You found the unsubscribe link!\n\n...Unfortunately, this feature requires Premium. Would you like to upgrade for only $29.99/month to unlock the ability to unsubscribe from free emails? 💸",
            );
