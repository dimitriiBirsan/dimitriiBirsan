---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import "../../styles/globals/index.css";
import "../../styles/elements/overload.css";
import DailyStreak from "./components/DailyStreak.astro";
import ActionPoints from "./components/ActionPoints.astro";
import ArtificialLoading from "./components/ArtificialLoading.astro";
import ShadowProgress from "./components/ShadowProgress.astro";
import GachaSystem from "./components/GachaSystem.astro";
import CurrencyConfusion from "./components/CurrencyConfusion.astro";
import ActualUnsubscribe from "./components/ActualUnsubscribe.astro";
import EthicalDisclaimer from "./components/EthicalDisclaimer.astro";
import ConfirmShaming from "./components/ConfirmShaming.astro";
import SocialProof from "./components/SocialProof.astro";
import FakeBanner from "./components/FakeBanner.astro";
import DarkPatternLabel from "./components/DarkPatternLabel.astro";

const tickerItems = [
    { user: "User7281", action: "just upgraded to Enterprise" },
    { user: "User3945", action: "purchased 10,000 Credits" },
    { user: "User1562", action: "unlocked Premium Features" },
    { user: "User9103", action: "just upgraded to Enterprise" },
    { user: "User6428", action: "purchased 10,000 Credits" },
    { user: "User2847", action: "unlocked Premium Features" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <div class="background-gradient"></div>

        <div class="container">
            <!-- Hero Section -->
            <div class="hero">
                <div class="cynical-badge">
                    ⚠️ Satirical Exposure of Dark Patterns
                </div>
                <h1>Dark Patterns</h1>
                <p class="subtitle">
                    SaaS Gamification & Retention Optimization: A Cynical
                    Framework for Behavioral Exploitation
                </p>
                <p
                    style="color: var(--text-muted); font-size: 0.95rem; max-width: 600px; margin-top: 1rem;"
                >
                    Every "feature" below is a working demonstration of real
                    dark patterns used to maximize Time In-App (TIA) and Average
                    Revenue Per User (ARPU). Because who needs ethics when you
                    have engagement metrics?
                </p>
            </div>
            <DailyStreak />

            <ActionPoints />
            <ArtificialLoading />

            <ShadowProgress />
            <GachaSystem />

            <CurrencyConfusion />

            <ConfirmShaming />

            <SocialProof />

            <FakeBanner />

            <EthicalDisclaimer />

            <ActualUnsubscribe />

            <footer
                style="text-align: center; padding: 4rem 0; color: var(--text-muted);"
            >
                <p>
                    Made with cynicism and a deep understanding of behavioral
                    psychology
                </p>
                <p style="font-size: 0.85rem; margin-top: 0.5rem;">
                    © 2026 Overload. All rights reserved. (And we mean ALL of
                    them.)
                </p>
            </footer>
        </div>

        <!-- Dark Pattern Label Toggle -->
        <button class="dp-toggle-btn" id="dpToggleBtn"> Toggle Labels </button>

        <script>
            // Toggle dark pattern labels visibility
            const toggleBtn = document.getElementById("dpToggleBtn");

            toggleBtn?.addEventListener("click", () => {
                document.body.classList.toggle("hide-dp-labels");
            });
        </script>
    </body>
</html>
