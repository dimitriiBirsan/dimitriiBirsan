        <script>
            // Streak Timer Countdown
            function updateStreakTimer() {
                const timer = document.getElementById("streakTimer");
                let [hours, minutes, seconds] = timer.textContent
                    .split(":")
                    .map(Number);

                seconds--;
                if (seconds < 0) {
                    seconds = 59;
                    minutes--;
                    if (minutes < 0) {
                        minutes = 59;
                        hours--;
                        if (hours < 0) {
                            hours = 23;
                        }
                    }
                }

                timer.textContent = `${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
            }
            setInterval(updateStreakTimer, 1000);

            // Action Points System
            let currentAP = 100;
            const useApBtn = document.getElementById("useApBtn");
            const apFill = document.getElementById("apFill");
            const apText = document.getElementById("apText");
            const rechargePrompt = document.getElementById("rechargePrompt");

            useApBtn.addEventListener("click", () => {
                if (currentAP >= 10) {
                    currentAP -= 10;
                    apFill.style.width = currentAP + "%";
                    apText.textContent = `${currentAP} / 100 AP`;

                    if (currentAP < 50) {
                        rechargePrompt.classList.add("show");
                    }

                    if (currentAP < 10) {
                        useApBtn.disabled = true;
                        useApBtn.textContent = "Insufficient AP ⚠️";
                        useApBtn.style.opacity = "0.5";
                        useApBtn.style.cursor = "not-allowed";
                    }
                }
            });

            // Gacha System
            let gachaBalance = 2347;
            const gachaSpin1x = document.getElementById("gachaSpin1x");
            const gachaSpin10x = document.getElementById("gachaSpin10x");
            const dropRatesBtn = document.getElementById("dropRatesBtn");
            const dropRatesModal = document.getElementById("dropRatesModal");
            const closeDropRates = document.getElementById("closeDropRates");
            const shardBalanceEl = document.getElementById("gachaShardBalance");

            // Modal controls
            dropRatesBtn?.addEventListener("click", () => {
                if (dropRatesModal) {
                    dropRatesModal.style.display = "flex";
                }
            });

            closeDropRates?.addEventListener("click", () => {
                if (dropRatesModal) {
                    dropRatesModal.style.display = "none";
                }
            });

            // Click backdrop to close
            dropRatesModal
                ?.querySelector(".modal-backdrop")
                ?.addEventListener("click", () => {
                    if (dropRatesModal) {
                        dropRatesModal.style.display = "none";
                    }
                });

            // Gacha spin function
            function performGachaSpin(isMulti = false) {
                const cost = isMulti ? 5000 : 500;
                const spins = isMulti ? 10 : 1;

                if (gachaBalance < cost) {
                    alert(
                        "Insufficient Insight Shards! (Time to open your wallet 💸)",
                    );
                    return;
                }

                gachaBalance -= cost;
                if (shardBalanceEl) {
                    shardBalanceEl.textContent = `${gachaBalance.toLocaleString()} Insight Shards`;
                }

                // Simulate gacha results (always near-miss for SR items)
                const results = [];
                for (let i = 0; i < spins; i++) {
                    // Rigged rates - mostly commons
                    const roll = Math.random();
                    if (roll < 0.005) {
                        // 0.5% SR (but never the featured one)
                        results.push({ rarity: "SR", item: "Custom Report" });
                    } else if (roll < 0.055) {
                        // 5% R
                        const rares = ["Dark Mode", "CSV Export", "Bulk Edit"];
                        results.push({
                            rarity: "R",
                            item: rares[
                                Math.floor(Math.random() * rares.length)
                            ],
                        });
                    } else {
                        // 94.5% N
                        const normals = ["Date Picker", "Email Notifications"];
                        results.push({
                            rarity: "N",
                            item: normals[
                                Math.floor(Math.random() * normals.length)
                            ],
                        });
                    }
                }

                // Show results
                const resultText = results
                    .map((r) => `${r.item} (${r.rarity})`)
                    .join(", ");
                alert(
                    `🎰 Gacha Results: ${resultText}\n\n(Notice how you didn't get Export PDF? Working as intended. 😈)`,
                );
            }

            gachaSpin1x?.addEventListener("click", () =>
                performGachaSpin(false),
            );
            gachaSpin10x?.addEventListener("click", () =>
                performGachaSpin(true),
            );

            // Confirmshaming buttons
            document.querySelectorAll(".btn").forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    if (btn.classList.contains("btn-shame")) {
                        alert(
                            "We're disappointed in you. But we respect your choice to fail. 😔",
                        );
                    } else {
                        alert(
                            "Great choice! Now entering your email into 127 marketing databases...",
                        );
                    }
                });
            });

            // Unsubscribe button (lol good luck finding it)
            document
                .getElementById("actualUnsubscribe")
                ?.addEventListener("click", (e) => {
                    e.preventDefault();
                    alert(
                        "Congratulations! You found the unsubscribe link!\n\n...Unfortunately, this feature requires Premium. Would you like to upgrade for only $29.99/month to unlock the ability to unsubscribe from free emails? 💸",
                    );
                });
        </script>
    </body>
</html>
