---
import TagsPage from '../../components/TagsPage.astro';
import { getPosts, tagSlug } from '../../utils/content';
export async function getStaticPaths() {
  return [...new Set((await getPosts('en')).flatMap((post) => post.data.tags))].map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag },
  }));
}
interface Props {
  tag: string;
}
---

<TagsPage language="en" tag={Astro.props.tag} />
