---
import { getCollection } from "astro:content";
import BaseHead from "../../../components/BaseHead.astro";
import Footer from "../../../components/Footer.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import Header from "../../../components/Header.astro";
import { useTranslations } from "../../../data/i18n/ui";

import { Image } from "astro:assets";
import "../../../styles/elements/blog.css";

const lang = "it";
const t = useTranslations(lang);

const posts = (await getCollection("blog"))
    .filter((post) => post.data.lang === "it")
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="it">
    <head>
        <BaseHead
            title="Blog | Dumitru Birsan"
            description="Articoli su sviluppo web, tecnologia e altro"
        />
    </head>
    <body>
        <Header language={lang} />
        <main class="container">
            <section>
                <h1 class="page-title">{t("blog.title")}</h1>
                <p class="page-subtitle">{t("blog.subtitle")}</p>
                <ul class="blog-grid">
                    {
                        posts.map((post) => (
                            <li class="blog-card">
                                <a href={`/it/blog/${post.id}/`}>
                                    <div class="card-image">
                                        {post.data.heroImage && (
                                            <Image
                                                width={720}
                                                height={360}
                                                src={post.data.heroImage}
                                                alt={post.data.title}
                                            />
                                        )}
                                    </div>
                                    <div class="card-content">
                                        <h4 class="title">{post.data.title}</h4>
                                        {post.data.description && (
                                            <p class="description">
                                                {post.data.description}
                                            </p>
                                        )}
                                        {post.data.tags &&
                                            post.data.tags.length > 0 && (
                                                <div class="tag-list">
                                                    {post.data.tags.map(
                                                        (tag) => (
                                                            <span class="tag-badge">
                                                                {tag}
                                                            </span>
                                                        ),
                                                    )}
                                                </div>
                                            )}
                                        <p class="date">
                                            <FormattedDate
                                                date={post.data.pubDate}
                                            />
                                        </p>
                                    </div>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </main>
        <Footer language={lang} />
    </body>
</html>
