---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import SiteLayout from './SiteLayout.astro';
import { SITE_URL } from '../consts';
import { formatDate, getLocalizedPathname } from '../utils/i18n';
import { postHref, tagSlug } from '../utils/content';
interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt, lang, tags } = post.data;
const social = heroImage
  ? await getImage({ src: heroImage, width: Math.min(heroImage.width, 1200), format: 'jpeg' })
  : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  mainEntityOfPage: new URL(postHref(post), SITE_URL).href,
  url: new URL(postHref(post), SITE_URL).href,
  inLanguage: lang,
  author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: 'Dumitru Birsan', url: SITE_URL },
  ...(social ? { image: new URL(social.src, SITE_URL).href } : {}),
};
---

<SiteLayout
  title={`${title} — Dumitru Birsan`}
  description={description}
  image={heroImage}
  imageAlt={heroAlt}
  type="article"
  structuredData={structuredData}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  </Fragment>
  <article class="reading">
    <header class="page-heading">
      <p class="meta">
        <a href={getLocalizedPathname('/blog', lang)}>{lang === 'it' ? 'Articoli' : 'Writing'}</a>
      </p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="article-meta meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang, 'long')}</time>
        {updatedDate && (
          <span>
            {lang === 'it' ? 'Aggiornato:' : 'Updated:'}{' '}
            <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time>
          </span>
        )}
      </div>
      <ul class="labels">
        {tags.map((tag) => (
          <li>
            <a href={getLocalizedPathname(`/tags/${tagSlug(tag)}`, lang)}>{tag}</a>
          </li>
        ))}
      </ul>
    </header>
    {heroImage && post.data.showHero && (
      <Image
        src={heroImage}
        alt={heroAlt}
        widths={[400, 720, 1000]}
        sizes="(max-width: 760px) calc(100vw - 32px), 720px"
        width={720}
        format="webp"
        loading="eager"
      />
    )}
    <div class="prose">
      <slot />
    </div>
  </article>
</SiteLayout>
