---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import { SITE_URL } from '../consts';
import { getLocalizedPathname } from '../utils/i18n';
import { projectHref } from '../utils/content';
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, description, technologies, lang, category } = project.data;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  url: new URL(projectHref(project), SITE_URL).href,
  inLanguage: lang,
  author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: 'Dumitru Birsan' },
  keywords: technologies.join(', '),
};
---

<SiteLayout title={`${title} — Dumitru Birsan`} description={description} structuredData={structuredData}>
  <article class="reading">
    <header class="page-heading">
      <p class="meta">
        <a href={getLocalizedPathname('/work', lang)}>{lang === 'it' ? 'Progetti' : 'Work'}</a> / {category}
      </p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <ul class="labels" aria-label={lang === 'it' ? 'Tecnologie' : 'Technologies'}>
        {technologies.map((technology) => (
          <li>{technology}</li>
        ))}
      </ul>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</SiteLayout>
