---
import { SITE_TITLE } from "../consts";
import Hamburger from "./Hamburger.astro";
import Navigation from "./Navigation.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLocalizedPathname, getLanguageFromURL } from "../utils/i18n";
import type { SupportedLanguage } from "../types/i18n";

interface Props {
	language?: SupportedLanguage;
}

const { language } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLang = language ?? getLanguageFromURL(currentPath);
const homeHref = getLocalizedPathname("/", currentLang);
---

<header>
	<nav>
		<Hamburger />
		<h2><a href={homeHref}>{SITE_TITLE}</a></h2>
		<Navigation language={currentLang} />
		<section class="switchers">
			<LanguageSwitcher currentPath={currentPath} />
			<ThemeSwitcher />
		</section>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		box-shadow: var(--shadow-sm);
		position: relative;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	.switchers {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
</style>
