---
import { getLanguageFromURL, getLocalizedPathname } from '../utils/i18n';
const language = getLanguageFromURL(Astro.url.pathname);
const local = (path: string) => getLocalizedPathname(path, language);
const links = [
  { path: '/work', label: language === 'it' ? 'Progetti' : 'Work' },
  { path: '/blog', label: language === 'it' ? 'Articoli' : 'Writing' },
  { path: '/about', label: language === 'it' ? 'Chi sono' : 'About' },
];
---

<a class="skip-link" href="#main">
  {language === 'it' ? 'Vai al contenuto' : 'Skip to content'}
</a>
<header class="site-header container">
  <a class="site-logo" href={local('/')}>
    Dumitru Birsan<span aria-hidden="true">.</span>
  </a>
  <div class="header-navigation">
    <nav aria-label={language === 'it' ? 'Navigazione principale' : 'Main navigation'}>
      {links.map(({ path, label }) => (
        <a href={local(path)} aria-current={Astro.url.pathname.startsWith(local(path)) ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <nav class="languages" aria-label={language === 'it' ? 'Lingua' : 'Language'}>
      <a
        href={getLocalizedPathname(Astro.url.pathname, 'en')}
        lang="en"
        hreflang="en"
        aria-label="English"
        aria-current={language === 'en' ? 'true' : undefined}
      >
        EN
      </a>
      <span aria-hidden="true">/</span>
      <a
        href={getLocalizedPathname(Astro.url.pathname, 'it')}
        lang="it"
        hreflang="it"
        aria-label="Italiano"
        aria-current={language === 'it' ? 'true' : undefined}
      >
        IT
      </a>
    </nav>
  </div>
</header>
