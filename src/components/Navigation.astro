---
import NavLink from "./NavLink.astro";
import { getLocalizedPathname } from "../utils/i18n";
import type { SupportedLanguage } from "../types/i18n";
import { useTranslations } from "../data/i18n/ui";

interface Props {
  language?: SupportedLanguage;
}

const { language = "en" } = Astro.props;
const t = useTranslations(language);

const currentUrl = Astro.request.url;

// Base routes (always in English format)
const BASE_ROUTES = ["/", "/blog", "/skills", "/about"] as const;

// Create route-to-label mapping using centralized translations
const routeLabelMap = new Map([
  ["/", t("nav.home")],
  ["/blog", t("nav.blog")],
  ["/skills", t("nav.skills")],
  ["/about", t("nav.about")],
]);

// Create route mapping with href and label
const routeMap = BASE_ROUTES.map((route) => ({
  href: getLocalizedPathname(route, language),
  label: routeLabelMap.get(route) || route.slice(1).toUpperCase(),
}));
---

<nav class="nav">
  {
    routeMap.map((route) => (
      <NavLink href={route.href} label={route.label} currentUrl={currentUrl} />
    ))
  }
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem;
    border-radius: var(--border-radius);
    background: color-mix(in srgb, var(--bg-secondary) 60%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-color);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav:hover {
    border-color: var(--accent-primary);
    box-shadow: 0 4px 20px
      color-mix(in srgb, var(--accent-primary) 15%, transparent);
  }

  @media (max-width: 636px) {
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: var(--bg-secondary);
      border-radius: 0 0 var(--border-radius) var(--border-radius);
      border: 1px solid var(--border-color);
      border-top: none;
      padding: 1rem;
      gap: 0.5rem;
      z-index: 100;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .nav.expanded {
      display: flex;
    }
  }
</style>
