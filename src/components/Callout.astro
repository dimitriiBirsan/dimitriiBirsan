---
interface Props {
    type?:
        | "note"
        | "tip"
        | "warning"
        | "caution"
        | "info"
        | "danger"
        | "insight";
    title?: string;
    collapsible?: boolean;
    collapsed?: boolean;
    prominent?: boolean;
}

const {
    type = "note",
    title,
    collapsible = false,
    collapsed = false,
    prominent = false,
} = Astro.props;

const typeConfig = {
    note: { color: "var(--accent-primary)", label: "Note" },
    insight: { color: "var(--accent-primary)", label: "Insight" },
    tip: { color: "var(--color-tip)", label: "Tip" },
    warning: { color: "var(--color-warning)", label: "Warning" },
    caution: { color: "var(--color-caution)", label: "Caution" },
    info: { color: "var(--color-info)", label: "Info" },
    danger: { color: "var(--color-danger)", label: "Danger" },
};

const config = typeConfig[type];
const displayTitle = title || config.label;
---

<div
    class="callout"
    data-type={type}
    data-collapsible={collapsible}
    data-prominent={prominent}
>
    <div class="callout-header">
        <span class="callout-title">{displayTitle}</span>
        {collapsible && <span class="callout-toggle">▼</span>}
    </div>
    <div class="callout-content" data-collapsed={collapsed}>
        <slot />
    </div>
</div>

<style define:vars={{ accentColor: config.color }}>
    .callout {
        margin: 1.5rem 0;
        padding: 1rem;
        border-left: 4px solid var(--accentColor);
        background: linear-gradient(
            135deg,
            var(--bg-secondary) 0%,
            color-mix(in srgb, var(--accentColor) 5%, transparent) 100%
        );
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
    }

    .callout:hover {
        box-shadow: var(--shadow-md);
    }

    .callout-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        font-weight: var(--font-weight-bold);
        color: var(--accentColor);
        cursor: default;
    }

    .callout[data-collapsible="true"] .callout-header {
        cursor: pointer;
        user-select: none;
    }

    .callout-icon {
        font-size: 1.25rem;
        line-height: 1;
    }

    .callout-title {
        font-size: 1rem;
        flex: 1;
    }

    .callout-toggle {
        font-size: 0.875rem;
        transition: transform 0.2s ease;
    }

    .callout[data-collapsible="true"]
        .callout-content[data-collapsed="true"]
        ~ .callout-header
        .callout-toggle {
        transform: rotate(-90deg);
    }

    .callout-content {
        color: var(--text-primary);
        line-height: var(--line-height-base);
    }

    .callout-content[data-collapsed="true"] {
        display: none;
    }

    .callout-content > :first-child {
        margin-top: 0;
    }

    .callout-content > :last-child {
        margin-bottom: 0;
    }

    /* Type-specific subtle backgrounds - removed in favor of dynamic color-mix */

    /* Responsive adjustments */
    @media (max-width: 636px) {
        .callout {
            margin: 1rem 0;
            padding: 0.875rem;
        }

        .callout-icon {
            font-size: 1.125rem;
        }

        .callout-title {
            font-size: 0.9375rem;
        }
    }

    .callout[data-prominent="true"] {
        font-size: 1.2em;
        line-height: 1.6;
    }

    .callout[data-prominent="true"] .callout-title {
        font-size: 1.3em;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const callouts = document.querySelectorAll(
            '.callout[data-collapsible="true"]',
        );

        callouts.forEach((callout) => {
            const header = callout.querySelector(".callout-header");
            const content = callout.querySelector(".callout-content");

            if (header && content) {
                header.addEventListener("click", () => {
                    const isCollapsed =
                        content.getAttribute("data-collapsed") === "true";
                    content.setAttribute(
                        "data-collapsed",
                        String(!isCollapsed),
                    );
                });
            }
        });
    });
</script>
