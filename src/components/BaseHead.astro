---
import '../styles/globals/index.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import socialImage from '../content/blog/devfest/keynote.jpg';
import { SITE_URL, SITE_TITLE } from '../consts';
import { getAlternateLinks, getLanguageFromURL, getLocalizedPathname } from '../utils/i18n';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description,
  image = socialImage,
  imageAlt = 'DevFest Modena 2025',
  type = 'website',
  noindex = false,
  structuredData,
} = Astro.props;
const language = getLanguageFromURL(Astro.url.pathname);
const canonical = new URL(getLocalizedPathname(Astro.url.pathname, language), SITE_URL).href;
const social = await getImage({ src: image, width: Math.min(image.width, 1200), format: 'jpeg' });
const imageUrl = new URL(social.src, SITE_URL).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonical} />
{!noindex &&
  getAlternateLinks(Astro.url.pathname).map(({ href, hreflang }) => (
    <link rel="alternate" href={href} hreflang={hreflang} />
  ))}
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} — ${language === 'it' ? 'Articoli' : 'Writing'}`}
  href={language === 'it' ? '/it/rss.xml' : '/rss.xml'}
/>
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={language === 'it' ? 'it_IT' : 'en_GB'} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{structuredData && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
  ></script>
)}
