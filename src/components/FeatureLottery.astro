---
import { Image } from 'astro:assets';
import darkMode from '../assets/lab/dark_mode_r.png';
import datePicker from '../assets/lab/date_picker_n.png';
import csvExport from '../assets/lab/csv_export_r.png';
import type { SupportedLanguage } from '../types/i18n';
interface Props {
  language: SupportedLanguage;
}
const { language } = Astro.props;
const it = language === 'it';
---

<div class="lottery" data-lottery data-language={language}>
  <div class="lottery-heading">
    <p class="meta">{it ? 'Analytics Gacha · demo giocabile' : 'Analytics Gacha · playable demo'}</p>
    <p class="lottery-balance">
      {it ? 'Saldo fittizio:' : 'Pretend balance:'} <strong data-balance>1500</strong>{' '}
      {it ? 'frammenti' : 'shards'}
    </p>
  </div>
  <h3 class="lottery-title">
    {it ? 'Esportazione CSV. Ora in edizione rara.' : 'CSV export. Now a rare collectible.'}
  </h3>
  <p class="lottery-description">
    {it
      ? 'Il report è pronto. La funzionalità per scaricarlo? Devi pescarla.'
      : 'Your report is ready. The feature to download it? You’ll have to draw that.'}
  </p>
  <div class="lottery-cards">
    {[
      { image: darkMode, label: 'Dark mode' },
      { image: datePicker, label: 'Date picker' },
      { image: csvExport, label: 'CSV export' },
    ].map(({ image, label }, index) => (
      <figure data-prize={index}>
        <Image
          src={image}
          alt=""
          width={220}
          widths={[120, 220, 440]}
          sizes="(max-width: 480px) 120px, 220px"
          loading="lazy"
          format="webp"
        />
        <figcaption>
          <strong>{label}</strong>
          <span data-prize-status>{it ? 'Da sbloccare' : 'Locked'}</span>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="lottery-controls" hidden>
    <div class="actions">
      <button type="button" class="button lottery-draw">
        {it ? 'Pesca · 500 frammenti' : 'Draw a feature · 500 shards'}
      </button>
      <a class="button lottery-export" href="/lab/sample.csv" download hidden>
        {it ? 'Scarica il CSV di esempio' : 'Download the sample CSV'}
      </a>
      <button type="button" class="button secondary lottery-mode" aria-pressed="false">
        {it ? 'Versione corretta' : 'Fair version'}
      </button>
      <button type="button" class="lottery-reset">
        {it ? 'Ricomincia' : 'Start over'}
      </button>
    </div>
    <p class="lottery-result" role="status" aria-live="polite" aria-atomic="true">
      {it
        ? 'Obiettivo: ottenere il CSV. Quanto può essere difficile?'
        : 'Your goal: get the CSV. How hard could it be?'}
    </p>
  </div>
  <details>
    <summary>{it ? 'Il trucco, per chi vuole sbirciare' : 'The trick, if you want to peek'}</summary>
    <p>
      {it
        ? 'Questa lotteria è truccata: alterna dark mode e date picker, poi ti dà un doppione. Il CSV non arriva mai. È il paradosso dell’esperimento: trasformare uno strumento di lavoro in un premio da inseguire. Nella versione corretta, un normale link scarica un CSV di esempio.'
        : 'This lottery is rigged: it alternates dark mode and a date picker, then gives you a duplicate. The CSV never arrives. That’s the absurdity I wanted to make tangible: turning a work tool into a prize to chase. In the fair version, a normal link downloads a sample CSV.'}
    </p>
  </details>
</div>
<style>
  .lottery {
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    margin-top: var(--space-5);
  }
  .lottery-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .lottery-heading p {
    font-size: 0.8125rem;
  }
  h3 {
    font-size: 1.6rem;
    margin-bottom: var(--space-3);
  }
  .lottery-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  figure {
    margin: 0;
    padding: var(--space-2);
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-small);
  }
  figure[data-unlocked] {
    border-color: var(--color-accent);
  }
  figure[data-drawn] {
    animation: reveal 250ms ease-out;
  }
  figcaption {
    padding: var(--space-2);
    color: var(--color-text);
    line-height: 1.5;
  }
  figcaption strong,
  figcaption span {
    display: block;
  }
  figcaption span {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-top: var(--space-1);
  }
  .lottery-result {
    margin-block: var(--space-5) 0;
    min-height: 3.5em;
  }
  .lottery-reset {
    background: none;
    border: none;
    color: var(--color-accent);
    padding: var(--space-2);
    min-height: 44px;
    text-decoration: underline;
    font-size: 0.875rem;
  }
  .lottery-mode[aria-pressed='true'] {
    border-color: var(--color-accent);
  }
  button:disabled {
    cursor: default;
    color: var(--color-muted);
    background: var(--color-bg);
    border-color: var(--color-border);
  }
  summary {
    cursor: pointer;
    color: var(--color-accent);
    padding-block: var(--space-3);
    min-height: 44px;
  }
  details {
    margin-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  details p {
    margin-top: var(--space-3);
  }
  @keyframes reveal {
    from {
      transform: translateY(6px);
    }
    to {
      transform: translateY(0);
    }
  }
  @media (max-width: 480px) {
    .lottery {
      padding: var(--space-4);
    }
    .lottery-cards {
      grid-template-columns: 1fr;
    }
    figure {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }
</style>
<script>
  const lottery = document.querySelector<HTMLElement>('[data-lottery]');
  if (lottery) {
    const it = lottery.dataset.language === 'it';
    const draw = lottery.querySelector<HTMLButtonElement>('.lottery-draw')!;
    const mode = lottery.querySelector<HTMLButtonElement>('.lottery-mode')!;
    const exportLink = lottery.querySelector<HTMLAnchorElement>('.lottery-export')!;
    const result = lottery.querySelector<HTMLElement>('.lottery-result')!;
    const balance = lottery.querySelector<HTMLElement>('[data-balance]')!;
    const balanceLabel = lottery.querySelector<HTMLElement>('.lottery-balance')!;
    const title = lottery.querySelector<HTMLElement>('.lottery-title')!;
    const description = lottery.querySelector<HTMLElement>('.lottery-description')!;
    const originalTitle = title.textContent;
    const originalDescription = description.textContent;
    const cards = [...lottery.querySelectorAll<HTMLElement>('[data-prize]')];
    let attempts = 0;
    let fair = false;
    const messages = it
      ? [
          'Hai trovato Dark mode. Bello, ma il report è ancora lì.',
          'Un Date picker! Adesso puoi scegliere il giorno in cui avresti voluto esportare il CSV.',
          'Un’altra Dark mode. Frammenti finiti, CSV ancora bloccato. Forse il problema è il prodotto.',
        ]
      : [
          'You drew Dark mode. Lovely. The report is still waiting.',
          'A Date picker! Now you can choose the day you wanted to export that CSV.',
          'Another Dark mode. No shards left, still no CSV. Perhaps the product is the problem.',
        ];
    const reset = () => {
      attempts = 0;
      fair = false;
      balance.textContent = '1500';
      balanceLabel.hidden = false;
      title.textContent = originalTitle;
      description.textContent = originalDescription;
      draw.hidden = false;
      draw.disabled = false;
      exportLink.hidden = true;
      mode.setAttribute('aria-pressed', 'false');
      for (const card of cards) {
        delete card.dataset.unlocked;
        delete card.dataset.drawn;
        card.querySelector('[data-prize-status]')!.textContent = it ? 'Da sbloccare' : 'Locked';
      }
      result.textContent = it
        ? 'Obiettivo: ottenere il CSV. Quanto può essere difficile?'
        : 'Your goal: get the CSV. How hard could it be?';
    };
    draw.addEventListener('click', () => {
      if (attempts >= 3 || fair) return;
      const card = cards[attempts % 2];
      for (const other of cards) delete other.dataset.drawn;
      card.dataset.unlocked = '';
      card.dataset.drawn = '';
      card.querySelector('[data-prize-status]')!.textContent =
        attempts === 2 ? (it ? 'Doppione' : 'Duplicate') : it ? 'Sbloccato' : 'Unlocked';
      result.textContent = messages[attempts];
      attempts += 1;
      balance.textContent = String(1500 - attempts * 500);
      draw.disabled = attempts === 3;
    });
    mode.addEventListener('click', () => {
      if (fair) {
        reset();
        return;
      }
      fair = true;
      balanceLabel.hidden = true;
      title.textContent = it ? 'Esportazione CSV. Inclusa.' : 'CSV export. Included.';
      description.textContent = it
        ? 'Il report è pronto. Puoi scaricarlo.'
        : 'Your report is ready. You can download it.';
      mode.setAttribute('aria-pressed', 'true');
      draw.hidden = true;
      exportLink.hidden = false;
      for (const card of cards) {
        card.dataset.unlocked = '';
        delete card.dataset.drawn;
        card.querySelector('[data-prize-status]')!.textContent = it ? 'Incluso' : 'Included';
      }
      result.textContent = it
        ? 'Ecco il tuo CSV. Un link, un file. Nessun frammento richiesto.'
        : 'Here’s your CSV. One link, one file. No shards required.';
    });
    lottery.querySelector('.lottery-reset')!.addEventListener('click', reset);
    lottery.querySelector<HTMLElement>('.lottery-controls')!.hidden = false;
  }
</script>
